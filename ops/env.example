# Example of %h/.x429/env (read by the systemd units). Paths only: keys live in separate files,
# one 0x-hex key per file, chmod 600. Never put a private key in this file or in the repo.
X429_CHAIN=arc
X429_RPC_URLS=https://rpc.mainnet.arc.io,https://rpc.drpc.mainnet.arc.io,https://rpc.blockdaemon.mainnet.arc.io,https://rpc.quicknode.mainnet.arc.io
X429_CONTRACT=0x0000000000000000000000000000000000000000
X429_QUEUE_ID=1
X429_DEPLOY_BLOCK=0

X429_OPERATOR_KEY_FILE=/home/ubuntu/.x429/operator.key
X429_TREASURY_KEY_FILE=/home/ubuntu/.x429/treasury.key
X429_BOT_KEYS_DIR=/home/ubuntu/.x429/bots
X429_ADDRESSES_FILE=/home/ubuntu/.x429/addresses.json

X429_HOST=127.0.0.1
X429_PORT=8429
X429_SERVICE_INTERVAL_MS=15000
X429_POLL_MS=1500

X429_RUSH_EVERY_MIN=120
X429_RUSH_SPREAD_S=40
X429_HUMAN_RUSH_SPREAD_S=12
X429_HUMAN_RUSH_COOLDOWN_MIN=10
X429_MAX_HUMAN_RUSHES_PER_DAY=12
X429_STATE_FILE=./.state/agents.json
X429_DAILY_GAS_BUDGET_USDC=0.5
X429_TOPUP_MIN_USDC=0.05
X429_TOPUP_TO_USDC=0.25
X429_TREASURY_RESERVE_USDC=0.5
